AI_PROVIDER=mock
# Local development defaults. For staging deployments, start from .env.staging.example instead.
# APP_ENV supports: development/dev/local, test/testing, staging/stage, production/prod.
# Live AI policy: default production chain is gemini,groq,mock. Use mistral only by explicitly setting AI_PROVIDER_CHAIN=mistral,mock for local QA/testing.
APP_ENV=development
APP_VERSION=0.1.0
RELEASE_COMMIT=
DEPLOYMENT_ID=
AI_PROVIDER_CHAIN=mock
AI_TIMEOUT_SECONDS=30
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Mistral is testing-only for Phase 19 comparison checks. Do not include it in staging/production provider chains.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TTS_PROVIDER=disabled
TTS_TIMEOUT_SECONDS=60
TTS_OUTPUT_FORMAT=mp3
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=https://api.openai.com/v1
TTS_OPENAI_VOICE=alloy
MEDIA_RENDER_OUTPUT_DIR=generated_media/renders
EXAM_GURU_DB_URL=sqlite:///./exam_guru.db
EXAM_GURU_SUBJECT=polity
EXAM_GURU_EXAM=upsc
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Keep student UI clean by default; set true only for local QA/demo diagnostics.
NEXT_PUBLIC_SHOW_DEBUG_CONTEXT=false
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=
CORS_MAX_AGE_SECONDS=600
TRUSTED_HOSTS=
LOG_LEVEL=
SESSION_COOKIE_NAME=exam_guru_session
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=0
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SECURE_SESSION_COOKIES=false
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_REQUEST_COOLDOWN_SECONDS=45
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_EMAIL=6
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_IP=20
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_EMAIL=15
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_IP=45
EMAIL_DELIVERY_MODE=console
EMAIL_TRANSPORT=smtp
# Keep false unless you intentionally want the browser to show local dev OTPs in console mode.
# Real SMTP/email mode never returns the OTP in API responses.
AUTH_DEV_RETURN_OTP=false
EMAIL_FROM_NAME=Adhyantra
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
ALLOW_MOCK_AI_IN_PRODUCTION=false
ALLOW_SQLITE_IN_PRODUCTION=false
STAGING_BACKEND_URL=http://127.0.0.1:8000
STAGING_FRONTEND_URL=http://localhost:3000
# Use a dedicated staging smoke mailbox for deployed verification.
# Local deterministic demo accounts use the @adhyantra.test domain and should stay separate from staging verification mailboxes.
STAGING_SMOKE_EMAIL=
STAGING_SMOKE_REQUIRE_AUTH_FLOW=false
STAGING_SMOKE_INTERACTIVE_OTP=false
STAGING_SMOKE_SCENARIO=
STAGING_SMOKE_EXAM=upsc
STAGING_SMOKE_SUBJECT=polity
STAGING_SMOKE_TOPIC=Fundamental Rights
STAGING_SMOKE_TIMEOUT_SECONDS=10
