# Adhyantra staging environment template.
# Copy values into your staging platform secret manager or deployment env.

# APP_ENV supports: staging/stage here. Use production/prod only after production cutover.
APP_ENV=staging
APP_VERSION=0.1.0
RELEASE_COMMIT=
DEPLOYMENT_ID=

# AI provider. Staging can intentionally allow mock AI, but production should not.
# Main Phase 19 routing is Gemini -> Groq -> mock. Mistral is testing-only and is rejected if added to a deployed provider chain.
AI_PROVIDER=gemini
AI_PROVIDER_CHAIN=gemini,groq,mock
AI_TIMEOUT_SECONDS=30
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Mistral credentials can be stored for local QA comparison, but do not add mistral to this staging provider chain.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ALLOW_MOCK_AI_IN_PRODUCTION=false

# Database. Prefer a managed staging DB. SQLite is tolerated in staging with a readiness warning.
# Set this in your staging secret manager. Do not commit real DB credentials.
EXAM_GURU_DB_URL=
ALLOW_SQLITE_IN_PRODUCTION=false

# Media worker and storage. External worker mode is safer once API and worker are separate processes.
# Replace this with a platform-appropriate absolute shared path or mounted volume
# so API and worker resolve the same artifacts consistently.
MEDIA_RENDER_WORKER_MODE=external
MEDIA_RENDER_OUTPUT_DIR=C:/adhyantra/media-renders
MEDIA_RENDER_WORKER_POLL_SECONDS=0.25
MEDIA_RENDER_CLAIM_LEASE_SECONDS=300
MEDIA_RENDER_WORKER_HEARTBEAT_SECONDS=15
MEDIA_RENDER_WORKER_STALE_AFTER_SECONDS=90
MEDIA_RENDER_ARTIFACT_RETENTION_HOURS=168

# Exam defaults remain internal compatibility env names.
EXAM_GURU_SUBJECT=polity
EXAM_GURU_EXAM=upsc

# Public deployment origins. These must be HTTPS and must not be localhost in staging.
NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com
# Keep student UI clean by default; set true only for controlled QA/demo diagnostics.
NEXT_PUBLIC_SHOW_DEBUG_CONTEXT=false
FRONTEND_ORIGIN=https://staging.example.com
BACKEND_PUBLIC_URL=https://api-staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With,X-Request-ID
CORS_MAX_AGE_SECONDS=600
TRUSTED_HOSTS=api-staging.example.com

# Session cookies. Use SameSite=none only if frontend/backend are on cross-site domains.
SESSION_COOKIE_NAME=exam_guru_session
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SECURE_SESSION_COOKIES=true

# OTP/email. Console delivery and dev OTP returns are blocked in deployed environments.
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_REQUEST_COOLDOWN_SECONDS=45
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_EMAIL=6
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_IP=20
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_EMAIL=15
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_IP=45
EMAIL_DELIVERY_MODE=email
EMAIL_TRANSPORT=smtp
AUTH_DEV_RETURN_OTP=false
EMAIL_FROM_NAME=Adhyantra
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO_ADDRESS=support@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Runtime visibility. Leave LOG_LEVEL blank to use the environment policy default.
LOG_LEVEL=
ADHYANTRA_STAGING_ENV_FILE=.env.staging
STAGING_BACKEND_HOST=0.0.0.0
STAGING_BACKEND_PORT=8000
STAGING_FRONTEND_HOST=0.0.0.0
STAGING_FRONTEND_PORT=3000
# Replace this with the IPs or CIDR ranges of the reverse proxy that terminates HTTPS for the backend.
UVICORN_PROXY_HEADERS=true
UVICORN_FORWARDED_ALLOW_IPS=*
STAGING_BACKEND_URL=https://api-staging.example.com
STAGING_FRONTEND_URL=https://staging.example.com
STAGING_SMOKE_EMAIL=
STAGING_SMOKE_REQUIRE_AUTH_FLOW=false
STAGING_SMOKE_INTERACTIVE_OTP=false
STAGING_SMOKE_EXAM=upsc
STAGING_SMOKE_SUBJECT=polity
STAGING_SMOKE_TOPIC=Fundamental Rights
STAGING_SMOKE_TIMEOUT_SECONDS=10
