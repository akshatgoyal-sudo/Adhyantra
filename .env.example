AI_PROVIDER=mock
# Local development defaults. For staging deployments, start from .env.staging.example instead.
# APP_ENV supports: development/dev/local, test/testing, staging/stage, production/prod.
# The verified free-tier production route is Gemini-only with mock forbidden. Groq and Mistral remain optional for local QA/testing.
APP_ENV=development
APP_VERSION=0.1.0
RELEASE_COMMIT=
DEPLOYMENT_ID=
AI_PROVIDER_CHAIN=mock
AI_TIMEOUT_SECONDS=30
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Mistral is testing-only for Phase 19 comparison checks. Do not include it in staging/production provider chains.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TTS_PROVIDER=disabled
TTS_TIMEOUT_SECONDS=60
TTS_OUTPUT_FORMAT=mp3
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=https://api.openai.com/v1
TTS_OPENAI_VOICE=alloy
TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts
TTS_GEMINI_VOICE=Kore
TTS_MAX_INPUT_CHARACTERS=4096
TTS_MAX_SEGMENTS=24
MEDIA_RENDER_OUTPUT_DIR=generated_media/renders
MEDIA_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=
MEDIA_STORAGE_REQUEST_TIMEOUT_SECONDS=15
MEDIA_STORAGE_MAX_OBJECT_BYTES=49000000
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_RENDER_WORKER_MODE=embedded
MEDIA_RENDER_WORKER_POLL_SECONDS=0.25
MEDIA_RENDER_CLAIM_LEASE_SECONDS=300
MEDIA_RENDER_WORKER_HEARTBEAT_SECONDS=15
MEDIA_RENDER_WORKER_STALE_AFTER_SECONDS=90
MEDIA_RENDER_ARTIFACT_RETENTION_HOURS=168
EXAM_GURU_DB_URL=sqlite:///./exam_guru.db
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_PRE_PING=true
EXAM_GURU_SUBJECT=polity
EXAM_GURU_EXAM=upsc
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Keep student UI clean by default; set true only for local QA/demo diagnostics.
NEXT_PUBLIC_SHOW_DEBUG_CONTEXT=false
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=
CORS_ALLOWED_HEADERS=
CORS_MAX_AGE_SECONDS=600
TRUSTED_HOSTS=
LOG_LEVEL=
SESSION_COOKIE_NAME=exam_guru_session
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=0
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SECURE_SESSION_COOKIES=false
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_REQUEST_COOLDOWN_SECONDS=45
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_EMAIL=6
EMAIL_OTP_MAX_REQUESTS_PER_HOUR_PER_IP=20
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_EMAIL=15
EMAIL_OTP_MAX_VERIFY_ATTEMPTS_PER_HOUR_PER_IP=45
EMAIL_DELIVERY_MODE=console
EMAIL_TRANSPORT=smtp
# Keep false unless you intentionally want the browser to show local dev OTPs in console mode.
# Real SMTP/email mode never returns the OTP in API responses.
AUTH_DEV_RETURN_OTP=false
EMAIL_FROM_NAME=Adhyantra
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
# Required only when EMAIL_TRANSPORT=brevo. Keep this backend-only.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=15
# Required only when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# For Gmail SMTP, use a Google App Password; never use the normal Google account password.
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
PAYMENT_PROVIDER=disabled
PAYMENT_TIMEOUT_SECONDS=30
PAYMENT_PREMIUM_PRICE_ID=
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_STRIPE_BASE_URL=https://api.stripe.com/v1
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
PAYMENT_RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RAZORPAY_BASE_URL=https://api.razorpay.com/v1
PAYMENT_RAZORPAY_TOTAL_COUNT=12
ALLOW_MOCK_AI_IN_PRODUCTION=false
ALLOW_SQLITE_IN_PRODUCTION=false
STAGING_BACKEND_URL=http://127.0.0.1:8000
STAGING_FRONTEND_URL=http://localhost:3000
# Use a dedicated staging smoke mailbox for deployed verification.
# Local deterministic demo accounts use the @adhyantra.test domain and should stay separate from staging verification mailboxes.
STAGING_SMOKE_EMAIL=
STAGING_SMOKE_REQUIRE_AUTH_FLOW=false
STAGING_SMOKE_INTERACTIVE_OTP=false
STAGING_SMOKE_SCENARIO=
STAGING_SMOKE_EXAM=upsc
STAGING_SMOKE_SUBJECT=polity
STAGING_SMOKE_TOPIC=Fundamental Rights
STAGING_SMOKE_TIMEOUT_SECONDS=10
